theme = Dark+

window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
window-save-state = always

macos-option-as-alt = left

keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = super+left=previous_tab
keybind = super+right=next_tab
keybind = ctrl+shift+k=scroll_page_lines:-5
keybind = ctrl+shift+j=scroll_page_lines:5
keybind = ctrl+shift+up=scroll_page_lines:-5
keybind = ctrl+shift+down=scroll_page_lines:5

split-divider-color = #707780
cursor-style = block
# ssh-env/ssh-terminfo install Ghostty's terminfo on remote hosts and fall
# back to xterm-256color, so TERM=xterm-ghostty does not break Neovim and
# other full-screen programs over ssh. Both are off by default.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

mouse-hide-while-typing = true

# Ghostty's built-in JetBrains Mono and Nerd Font symbols need no install.
# Unpinned Hangul falls back to any monospace Hangul font (D2Coding, PCMyungjo);
# the map pins the macOS font, and Ghostty size-matches mapped fonts to cells.
font-codepoint-map = U+1100-U+11FF,U+3130-U+318F,U+A960-U+A97F,U+AC00-U+D7AF,U+D7B0-U+D7FF=Apple SD Gothic Neo
font-feature = -calt, -liga, -dlig
# Size-matched Hangul fills its rows; 10% taller cells (about 1.45 line height,
# from JetBrains Mono's 1.32) give them room, and the cursor fills the cell.
adjust-cell-height = 10%
adjust-cursor-height = 10%
