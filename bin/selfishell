#!/usr/bin/env bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="${source_path%/*}"
  [[ "$source_dir" != "$source_path" ]] || source_dir=.
  source_dir="$(cd "$source_dir" && pwd -P)"
  source_path="$(readlink "$source_path")"
  [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
done
source_dir="${source_path%/*}"
[[ "$source_dir" != "$source_path" ]] || source_dir=.
root_dir="$(cd "$source_dir/.." && pwd -P)"
binary="$root_dir/.build/selfishell"
if [[ ! -x "$binary" ]]; then
  printf 'Selfishell development binary is missing: %s\nRun bash scripts/build-cli.sh from %s with the pinned Go version in go.mod.\n' "$binary" "$root_dir" >&2
  exit 1
fi
exec "$binary" "$@"
